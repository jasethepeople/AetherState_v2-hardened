{
  "name": "aetherstate",
  "version": "2.0.0",
  "description": "AetherState: A real-time collaborative CRDT platform with WebRTC mesh networking, JWT-based access control, and semantic indexing for edge-synchronized human-AI collaboration.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-server.js",
    "start:bridge": "node dist/bridge-server.js",
    "start:signaling": "node dist/webrtc-signaling.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "dev:mcp": "ts-node-dev --respawn src/mcp-server.ts",
    "dev:bridge": "ts-node-dev --respawn src/bridge-server.ts",
    "dev:signaling": "ts-node-dev --respawn src/webrtc-signaling.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.10",
    "pg": "^8.11.3",
    "yjs": "^13.6.8",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "langchain": "^0.0.200",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.16",
    "@types/pg": "^8.10.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.10",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "crdt",
    "real-time",
    "collaboration",
    "webrtc",
    "websocket",
    "yjs",
    "distributed",
    "edge-computing",
    "ai-agents",
    "human-ai-collaboration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/aetherstate.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/aetherstate/issues"
  },
  "homepage": "https://github.com/yourusername/aetherstate#readme"
}
