# =============================================================================
# AETHERSTATE v2.0 — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Authentication (REQUIRED)
# -----------------------------------------------------------------------------
# RSA public key in PEM format for verifying JWT tokens.
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
# Then paste the contents of public.pem here (with actual newlines):
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
YOUR_PUBLIC_KEY_HERE
...
-----END PUBLIC KEY-----

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Redis — Hot cache for document state and real-time sync
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# PostgreSQL — Durable persistence for document snapshots and operation history
POSTGRES_URL=postgresql://user:password@localhost:5432/aetherstate

# -----------------------------------------------------------------------------
# Server Ports
# -----------------------------------------------------------------------------
MCP_PORT=3000
BRIDGE_PORT=8080
SIGNALING_PORT=8081
METRICS_PORT=8082

# -----------------------------------------------------------------------------
# Document Lifecycle
# -----------------------------------------------------------------------------
# Time-to-live for in-memory documents (ms) — 30 minutes default
DOC_TTL=1800000

# Maximum operations per document before forced snapshot
MAX_DOC_SIZE=10000

# Snapshot interval for persisting dirty documents (ms) — 5 minutes
SNAPSHOT_INTERVAL=300000

# -----------------------------------------------------------------------------
# WebSocket Pool Configuration
# -----------------------------------------------------------------------------
WS_POOL_MAX_SIZE=50
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable semantic embedding indexing for operations
ENABLE_EMBEDDING=true

# Enable metrics endpoints
ENABLE_METRICS=true

# Enable audit logging
ENABLE_AUDIT_LOG=true

# Enable cellular mesh topology for WebRTC (recommended for >8 peers per doc)
ENABLE_CELLULAR_MESH=false
CELLULAR_MESH_SIZE=8

# -----------------------------------------------------------------------------
# WebRTC Signaling
# -----------------------------------------------------------------------------
# Maximum peers per document before rejecting new connections
MAX_PEERS_PER_DOC=50

# Peer inactivity timeout (ms) — 2 minutes
PEER_TIMEOUT=120000

# -----------------------------------------------------------------------------
# PostgreSQL Connection Pool
# -----------------------------------------------------------------------------
POSTGRES_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
